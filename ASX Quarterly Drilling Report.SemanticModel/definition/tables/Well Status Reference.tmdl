	partition 'Well Status Reference' = m
		mode: import
		source =
				let
				    // Demo mode uses the embedded synthetic sample data (see /sample-data); otherwise query PPDM directly.
				    Source = if UseSampleData
				        then LoadSampleData("", {{"EFFECTIVE_DATE", type datetime}, {"EXPIRY_DATE", type datetime}, {"ROW_CHANGED_DATE", type datetime}, {"ROW_CREATED_DATE", type datetime}})
				        else Oracle.Database(PPDM_Connection, [HierarchicalNavigation=true, Query="select * from r_well_status #(lf)"]),
				    #"Sorted Rows1" = Table.Sort(Source,{{"STATUS", Order.Ascending}}),
				    #"Sorted Rows" = Table.Sort(#"Sorted Rows1",{{"STATUS", Order.Ascending}}),
				    #"Filtered Rows" = Table.SelectRows(#"Sorted Rows", each ([STATUS_TYPE] = "ONLINE_STATUS" or [STATUS_TYPE] = "WELL_STATUS")),
				    #"Renamed Columns" = Table.RenameColumns(#"Filtered Rows",{{"LONG_NAME", "LONG NAME"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

