		variation Variation
			isDefault
			relationship: c548de38-ab39-4134-b01d-5b17036ebecc
			defaultHierarchy: LocalDateTable_de63fbae-0572-4ec7-ad14-6d61dfa095e1.'Date Hierarchy'

