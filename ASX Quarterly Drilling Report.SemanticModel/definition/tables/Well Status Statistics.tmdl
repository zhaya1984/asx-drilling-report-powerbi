	partition 'Well Status Statistics' = m
		mode: import
		source =
				let
				    // Demo mode uses the embedded synthetic sample data (see /sample-data); otherwise query PPDM directly.
				    Source = if UseSampleData
				        then LoadSampleData("", {{"SPUD_DATE", type datetime}})
				        else Oracle.Database(PPDM_Connection, [HierarchicalNavigation=true, Query="SELECT #(lf)    a.COUNTRY AS COUNTRY,#(lf)    a.STATUS_TYPE,#(lf)    a.CURRENT_STATUS,#(lf)    COALESCE(WST.LONG_NAME, WST.SHORT_NAME, WST.ABBREVIATION, a.CURRENT_STATUS) AS STATUS_DESCRIPTION,#(lf)    WST.ACTIVE_IND,#(lf)    a.UWI,#(lf)    a.WELL_NAME,#(lf)    a.WELL_NUM,#(lf)    a.PRIMARY_SOURCE,#(lf)    a.SPUD_DATE#(lf)FROM WELL a#(lf)LEFT JOIN R_WELL_STATUS WST #(lf)    ON a.STATUS_TYPE = WST.STATUS_TYPE #(lf)   AND a.CURRENT_STATUS = WST.STATUS#(lf)#(lf)WHERE a.COUNTRY IN ('PG','AU')#(lf)#(lf)"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

