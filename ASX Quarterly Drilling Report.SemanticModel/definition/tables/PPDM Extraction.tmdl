	column 'Rig Release Date'
		dataType: dateTime
		formatString: d/mm/yy
		lineageTag: fd0dea98-da8a-4622-8591-eecf48401f7a
		summarizeBy: none
		sourceColumn: Rig Release Date

		variation Variation
			isDefault
			relationship: bd30ca2c-d9a7-4db0-8088-48d65fdf759e
			defaultHierarchy: LocalDateTable_d86e3b54-52ef-461d-821f-d1f297f2ee18.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition 'PPDM Extraction-9db455cd-3a18-44ae-8d90-51af1fce299f' = m
		mode: import
		source =
				let
				    // Demo mode uses the embedded synthetic sample data (see /sample-data); otherwise query PPDM directly.
				    Source = if UseSampleData
				        then LoadSampleData("", {{"Spud Date", type datetime}, {"Rig Release Date", type datetime}, {"Child Spud Date", type datetime}, {"Child Rig Release Date", type datetime}, {"Latest ST Spud Quarter Sort", type datetime}, {"Combined Sort", Int64.Type}})
				        else Oracle.Database(PPDM_Connection, [HierarchicalNavigation=true, Query="SELECT#(lf)#(lf)/*=========================================================================#(lf)    WELL IDENTIFICATION#(lf)=========================================================================*/#(lf)#(lf)    -- For a sidetrack, display the original surface well name.#(lf)    -- Otherwise, display the well's own name.#(lf)    COALESCE(wx.surface_well_name, w.WELL_NAME)                          AS ""WELL NAME"",#(lf)#(lf)    -- Latest sidetrack / deepen child well; NULL when no child exists.#(lf)    ls.latest_well_name                                                  AS ""DW/ST WELL"",#(lf)#(lf)    w.PROVINCE_STATE                                                     AS ""STATE"",#(lf)#(lf)#(lf)/*=========================================================================#(lf)    SIDETRACK / DEEPEN WELL SUMMARY#(lf)=========================================================================*/#(lf)#(lf)    -- Human-readable summary of the original well spud quarter and the#(lf)    -- latest sidetrack / deepen child's name and spud quarter.#(lf)    -- Returns NULL when no child exists or either spud date is invalid.#(lf)    CASE#(lf)        WHEN ls.parent_uwi IS NULL THEN NULL#(lf)        WHEN w.SPUD_DATE IS NULL OR w.SPUD_DATE < DATE '1900-01-01' THEN NULL#(lf)        WHEN ls.latest_spud_date IS NULL OR ls.latest_spud_date < DATE '1900-01-01' THEN NULL#(lf)        ELSE 'Original well spud at Q' || TO_CHAR(w.SPUD_DATE, 'Q') || ' ' || TO_CHAR(w.SPUD_DATE, 'YYYY')#(lf)             || ', ' || ls.latest_well_name#(lf)             || ' spud at Q' || TO_CHAR(ls.latest_spud_date, 'Q') || ' ' || TO_CHAR(ls.latest_spud_date, 'YYYY')#(lf)    END                                                                  AS ""Sidetrack/Deepen Well Spud Summary"",#(lf)#(lf)#(lf)/*=========================================================================#(lf)    COMPANY WORKING INTEREST#(lf)=========================================================================*/#(lf)#(lf)    -- Map the current JV contract name to the company's working interest.#(lf)    -- Illustrative values only.#(lf)    CASE jv.CONTRACT_NAME#(lf)        WHEN 'JV Alpha'               THEN '60.00%'#(lf)        WHEN 'JV Bravo'               THEN '75.00%'#(lf)        WHEN 'JV Charlie'             THEN '30.00%'#(lf)        WHEN 'JV Delta Unit'          THEN '50.00%'#(lf)        WHEN 'Permit Echo'            THEN '100.00%'#(lf)        WHEN 'Permit Foxtrot'         THEN '25.00%'#(lf)        WHEN 'Permit Golf'            THEN '42.50%'#(lf)        ELSE NULL#(lf)    END                                                                  AS ""WORKING INTEREST"",#(lf)#(lf)#(lf)/*=========================================================================#(lf)    WELL STATUS#(lf)=========================================================================*/#(lf)#(lf)    -- Use the latest sidetrack / deepen child status when one exists;#(lf)    -- otherwise, use the parent well's current status.#(lf)    CASE#(lf)        WHEN CASE WHEN ls.parent_uwi IS NOT NULL THEN ls.latest_status ELSE w.CURRENT_STATUS END#(lf)             IN ('SUG','SUGO','SUOG','SUO','SUGI','SFD','CS','SST')      THEN 'C&S, Successful'#(lf)        WHEN CASE WHEN ls.parent_uwi IS NOT NULL THEN ls.latest_status ELSE w.CURRENT_STATUS END#(lf)             IN ('PSG','PSO')                                            THEN 'P&S, Successful'#(lf)        WHEN CASE WHEN ls.parent_uwi IS NOT NULL THEN ls.latest_status ELSE w.CURRENT_STATUS END#(lf)             IN ('SCG','SCGC','SCGO','SCO','SCW')                       THEN 'C&C, Successful'#(lf)        WHEN CASE WHEN ls.parent_uwi IS NOT NULL THEN ls.latest_status ELSE w.CURRENT_STATUS END#(lf)             IN ('ABOS','ABGO','ABGS','ABS','AST','ABJ','PA','PAG','PAO','ABDH') THEN 'P&A, Unsuccessful'#(lf)        WHEN CASE WHEN ls.parent_uwi IS NOT NULL THEN ls.latest_status ELSE w.CURRENT_STATUS END#(lf)             = 'OB'                                                      THEN 'Observation Well'#(lf)        WHEN CASE WHEN ls.parent_uwi IS NOT NULL THEN ls.latest_status ELSE w.CURRENT_STATUS END#(lf)             = 'DRI'                                                     THEN 'Drilling'#(lf)        ELSE '-'#(lf)    END                                                                  AS ""STATUS"",#(lf)#(lf)    -- Raw PPDM status code using the same parent / child selection logic.#(lf)    CASE#(lf)        WHEN ls.parent_uwi IS NOT NULL THEN ls.latest_status#(lf)        ELSE w.CURRENT_STATUS#(lf)    END                                                                  AS ""PPDM Status"",#(lf)#(lf)#(lf)/*=========================================================================#(lf)    WELL ATTRIBUTES#(lf)=========================================================================*/#(lf)#(lf)    null                                                                 AS ""Asset Verification"",#(lf)    w.CO_PRODUCT_TYPE                                                  AS ""Product Type"",#(lf)    o.ORGANIZATION_ID                                                    AS ""Operated/Interest"",#(lf)    w.ENVIRONMENT_TYPE                                                   AS ""Environment Type"",#(lf)    w.COUNTRY                                                            AS ""Country"",#(lf)    ps_get_well_component(w.uwi, 'BASIN', 100)                           AS ""Basin"",#(lf)    b.BA_NAME                                                            AS ""Initial Operator"",#(lf)    c.BA_NAME                                                            AS ""Current Operator"",#(lf)    jv.CONTRACT_NAME                                                     AS ""Current JV"",#(lf)    ps_get_well_component(w.uwi, 'PERMIT', 100)                          AS ""Permit"",#(lf)    w.CURRENT_CLASS                                                      AS ""Current Class"",#(lf)    w.CO_SECONDARY_CLASS_1                                             AS ""2nd Class"",#(lf)      -- Group the detailed current class into a reporting category used to#(lf)    -- distinguish exploration / appraisal, development and water wells.#(lf)    CASE#(lf)        WHEN w.CURRENT_CLASS IN ('EXP', 'APP', 'NFE') THEN 'EXP/APP'#(lf)        WHEN w.CURRENT_CLASS = 'DEV'                  THEN 'DEV'#(lf)        WHEN w.CURRENT_CLASS = 'WTR'                  THEN 'WATER'#(lf)        ELSE NULL#(lf)    END                                                                  AS ""Well Category"",#(lf)#(lf)#(lf)/*=========================================================================#(lf)    WELL DATES#(lf)=========================================================================*/#(lf)#(lf)    -- Parent well dates.#(lf)    w.SPUD_DATE                                                          AS ""Spud Date"",#(lf)    w.RIG_RELEASE_DATE                                                   AS ""Rig Release Date"",#(lf)#(lf)    -- Most recent valid sidetrack / deepen child dates.#(lf)    ls.latest_spud_date                                                  AS ""Child Spud Date"",#(lf)    ls.latest_rig_release_date                                           AS ""Child Rig Release Date"",#(lf)#(lf)#(lf)/*=========================================================================#(lf)    POWER BI SORT COLUMNS#(lf)=========================================================================*/#(lf)#(lf)    -- Sort key for the latest sidetrack spud quarter.#(lf)    CASE#(lf)        WHEN ls.parent_uwi IS NULL THEN NULL#(lf)        WHEN ls.latest_spud_date IS NULL THEN NULL#(lf)        WHEN ls.latest_spud_date < DATE '1900-01-01' THEN NULL#(lf)        ELSE TRUNC(ls.latest_spud_date, 'Q')#(lf)    END                                                                  AS ""Latest ST Spud Quarter Sort"",#(lf)#(lf)    -- Three-level numeric sort: Current Class -> Basin -> Product Type.#(lf)    CASE w.CURRENT_CLASS#(lf)        WHEN 'EXP'  THEN 1#(lf)        WHEN 'APP'  THEN 1#(lf)        WHEN 'NFE'  THEN 1#(lf)        WHEN 'DEV'  THEN 4#(lf)        WHEN 'WTR'  THEN 5#(lf)        ELSE 99#(lf)    END * 10000#(lf)    +#(lf)    CASE ps_get_well_component(w.uwi, 'BASIN', 100)#(lf)        WHEN 'Basin A' THEN 1#(lf)        WHEN 'Basin B' THEN 2#(lf)        WHEN 'Basin C' THEN 3#(lf)        WHEN 'Basin D' THEN 4#(lf)        WHEN 'Basin E' THEN 5#(lf)        WHEN 'Basin F' THEN 6#(lf)        WHEN 'Basin G' THEN 7#(lf)        ELSE 99#(lf)    END * 100#(lf)    +#(lf)    CASE w.CO_PRODUCT_TYPE#(lf)        WHEN 'OIL'  THEN 1#(lf)        WHEN 'GAS'  THEN 2#(lf)        WHEN 'OG'   THEN 3#(lf)        WHEN 'CSG'  THEN 4#(lf)        WHEN 'CDS'  THEN 5#(lf)        WHEN 'WTR'  THEN 6#(lf)        WHEN 'COAL' THEN 7#(lf)        ELSE 99#(lf)    END                                                                  AS ""Combined Sort"",#(lf)#(lf)#(lf)/*=========================================================================#(lf)    POWER BI QUARTER LABELS#(lf)=========================================================================*/#(lf)#(lf)    -- Parent well spud quarter.#(lf)    CASE#(lf)        WHEN w.SPUD_DATE IS NULL THEN NULL#(lf)        WHEN w.SPUD_DATE < DATE '1900-01-01' THEN NULL#(lf)        ELSE 'Q' || TO_CHAR(w.SPUD_DATE, 'Q') || ' ' || TO_CHAR(w.SPUD_DATE, 'YYYY')#(lf)    END                                                                  AS ""Spud Quarter Label"",#(lf)#(lf)    -- Parent well rig release quarter.#(lf)    CASE#(lf)        WHEN w.RIG_RELEASE_DATE IS NULL THEN NULL#(lf)        WHEN w.RIG_RELEASE_DATE < DATE '1900-01-01' THEN NULL#(lf)        ELSE 'Q' || TO_CHAR(w.RIG_RELEASE_DATE, 'Q') || ' ' || TO_CHAR(w.RIG_RELEASE_DATE, 'YYYY')#(lf)    END                                                                  AS ""Rig Release Quarter"",#(lf)#(lf)    -- Latest sidetrack / deepen child spud quarter.#(lf)    CASE#(lf)        WHEN ls.latest_spud_date IS NULL THEN NULL#(lf)        WHEN ls.latest_spud_date < DATE '1900-01-01' THEN NULL#(lf)        ELSE 'Q' || TO_CHAR(ls.latest_spud_date, 'Q') || ' ' || TO_CHAR(ls.latest_spud_date, 'YYYY')#(lf)    END                                                                  AS ""Child Spud Quarter"",#(lf)#(lf)    -- Latest sidetrack / deepen child rig release quarter.#(lf)    CASE#(lf)        WHEN ls.latest_rig_release_date IS NULL THEN NULL#(lf)        WHEN ls.latest_rig_release_date < DATE '1900-01-01' THEN NULL#(lf)        ELSE 'Q' || TO_CHAR(ls.latest_rig_release_date, 'Q') || ' ' || TO_CHAR(ls.latest_rig_release_date, 'YYYY')#(lf)    END                                                                  AS ""Child Rig Release Quarter Label"",#(lf)#(lf)    -- Effective reporting quarter: latest valid child spud quarter when#(lf)    -- available; otherwise, the parent well spud quarter.#(lf)    CASE#(lf)        WHEN COALESCE(ls.latest_spud_date, w.SPUD_DATE) IS NULL THEN NULL#(lf)        WHEN COALESCE(ls.latest_spud_date, w.SPUD_DATE) < DATE '1900-01-01' THEN NULL#(lf)        ELSE 'Q' || TO_CHAR(COALESCE(ls.latest_spud_date, w.SPUD_DATE), 'Q')#(lf)                 || ' ' || TO_CHAR(COALESCE(ls.latest_spud_date, w.SPUD_DATE), 'YYYY')#(lf)    END                                                                  AS ""Reporting Spud Quarter""#(lf)#(lf)#(lf)/*=========================================================================#(lf)    SOURCE TABLE#(lf)=========================================================================*/#(lf)#(lf)FROM WELL w#(lf)#(lf)#(lf)/*=========================================================================#(lf)    LOOKUP: CURRENT JOINT VENTURE#(lf)=========================================================================*/#(lf)#(lf)-- Retrieve the current JV contract name for each well.#(lf)LEFT JOIN (#(lf)    SELECT wc.uwi, c.CONTRACT_NAME#(lf)    FROM well_component wc#(lf)    JOIN contract c ON wc.contract_id = c.contract_id#(lf)    WHERE wc.WELL_COMPONENT_TYPE = 'JOINT_VENTURE_CURR'#(lf)) jv ON w.UWI = jv.UWI#(lf)#(lf)#(lf)/*=========================================================================#(lf)    LOOKUP: WELL ORIGIN#(lf)=========================================================================*/#(lf)#(lf)-- Retrieve the original surface well name through WELL_ORIGIN.#(lf)-- LEFT JOIN retains parent wells that do not have sidetracks.#(lf)LEFT JOIN (#(lf)    SELECT wx.uwi, w2.well_name AS surface_well_name#(lf)    FROM PPDM38.well w2#(lf)    JOIN PPDM38.well_xref wx ON w2.uwi = wx.uwi2#(lf)    WHERE wx.xref_type = 'WELL_ORIGIN'#(lf)) wx ON w.UWI = wx.UWI#(lf)#(lf)#(lf)/*=========================================================================#(lf)    LOOKUP: LATEST SIDETRACK / DEEPEN WELL#(lf)=========================================================================*/#(lf)#(lf)-- For each parent well, return the most recent child well based on spud date.#(lf)-- Children with missing or invalid spud dates are excluded.#(lf)-- Suspicious children with missing dates should be reviewed separately.#(lf)LEFT JOIN (#(lf)    SELECT DISTINCT#(lf)        wx.uwi2                                  AS parent_uwi,#(lf)        FIRST_VALUE(w2.WELL_NAME) OVER (#(lf)            PARTITION BY wx.uwi2#(lf)            ORDER BY w2.spud_date DESC#(lf)        )                                        AS latest_well_name,#(lf)        FIRST_VALUE(w2.CURRENT_STATUS) OVER (#(lf)            PARTITION BY wx.uwi2#(lf)            ORDER BY w2.spud_date DESC#(lf)        )                                        AS latest_status,#(lf)        FIRST_VALUE(w2.RIG_RELEASE_DATE) OVER (#(lf)            PARTITION BY wx.uwi2#(lf)            ORDER BY w2.spud_date DESC#(lf)        )                                        AS latest_rig_release_date,#(lf)        FIRST_VALUE(w2.spud_date) OVER (#(lf)            PARTITION BY wx.uwi2#(lf)            ORDER BY w2.spud_date DESC#(lf)        )                                        AS latest_spud_date#(lf)    FROM PPDM38.well_xref wx#(lf)    JOIN PPDM38.well w2 ON w2.uwi = wx.uwi#(lf)    WHERE wx.xref_type = 'WELL_ORIGIN'#(lf)    AND w2.spud_date IS NOT NULL#(lf)    AND w2.spud_date > DATE '1900-01-01'#(lf)) ls ON w.UWI = ls.parent_uwi#(lf)#(lf)#(lf)/*=========================================================================#(lf)    MASTER DATA JOINS#(lf)=========================================================================*/#(lf)#(lf)JOIN WELL_COMPONENT wc    ON w.uwi = wc.uwi#(lf)JOIN BUSINESS_ASSOCIATE b ON b.BUSINESS_ASSOCIATE = w.OPERATOR#(lf)JOIN BUSINESS_ASSOCIATE c ON c.BUSINESS_ASSOCIATE = w.CO_CURRENT_OPERATOR#(lf)#(lf)#(lf)/*=========================================================================#(lf)    BUSINESS UNIT ORGANISATION#(lf)=========================================================================*/#(lf)#(lf)/*#(lf)Root cause#(lf)----------#(lf)BA_ORGANIZATION contains two definitions for ORGANIZATION_ID = 'BU01':#(lf)#(lf)1. BUSINESS_ASSOCIATE = 'COMPANY'        — manually maintained master record.#(lf)2. BUSINESS_ASSOCIATE = 'COMPANY_LEGACY' — legacy record from a historical bulk load.#(lf)#(lf)Both records have the same ORGANIZATION_ID and ORGANIZATION_TYPE. The original#(lf)join could not distinguish between them, so each well matched twice and the#(lf)entire report was duplicated.#(lf)#(lf)Fix#(lf)---#(lf)Restrict the join to BUSINESS_ASSOCIATE = 'COMPANY' so that only the intended#(lf)record is retained and the legacy record is excluded.#(lf)*/#(lf)JOIN ba_organization o    ON wc.BA_ORGANIZATION_ID = o.ORGANIZATION_ID#(lf)                          AND o.BUSINESS_ASSOCIATE = 'COMPANY'#(lf)#(lf)#(lf)/*=========================================================================#(lf)    FILTERS#(lf)=========================================================================*/#(lf)#(lf)WHERE#(lf)    -- Include both onshore and offshore wells.#(lf)    w.ENVIRONMENT_TYPE IN ('ONSHORE', 'OFFSHORE')#(lf)#(lf)    -- Restrict well components and organisations to the in-scope business units.#(lf)    AND wc.WELL_COMPONENT_TYPE = 'BUSINESS_UNIT'#(lf)    AND o.ORGANIZATION_TYPE = 'BUSINESS_UNIT'#(lf)    AND o.ORGANIZATION_ID IN ('BU01','BU02')#(lf)#(lf)    -- Exclude Straddle and Disposal wells.#(lf)    AND w.CURRENT_STATUS NOT IN ('STR', 'DOP')#(lf)#(lf)    -- Include wells spudded after 1 January 2020.#(lf)    AND w.spud_date > DATE '2020-01-01'#(lf)#(lf)    -- Exclude child sidetrack / deepen wells so only top-level parent wells remain.#(lf)    AND w.UWI NOT IN (#(lf)        SELECT uwi#(lf)        FROM PPDM38.well_xref#(lf)        WHERE xref_type = 'WELL_ORIGIN'#(lf)    )"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

